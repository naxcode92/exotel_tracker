# Flask session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_random_hex_string_here

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ALLOWED_DOMAIN=futwork.com

# Exotel accounts
FUTWORK1M_SID=futwork1m
FUTWORK1M_API_KEY=your_api_key_here
FUTWORK1M_API_TOKEN=your_api_token_here

FUTWORK12M_SID=futwork12m
FUTWORK12M_API_KEY=your_api_key_here
FUTWORK12M_API_TOKEN=your_api_token_here
